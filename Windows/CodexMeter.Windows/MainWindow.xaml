<Window
    x:Class="CodexMeter.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Codex Meter">
    <ScrollViewer x:Name="Root" Loaded="Window_Loaded">
        <StackPanel Spacing="16" Padding="24">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Codex Meter" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Windows 额度概览" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="关于Codex Meter" Click="About_Click" />
                    <Button Content="刷新" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <InfoBar IsOpen="True" Severity="Informational" Title="{Binding StatusText}" IsClosable="False" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="5 小时额度" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FiveHourRemaining}" FontSize="40" FontWeight="Bold" />
                        <ProgressBar Value="{Binding FiveHourRemainingValue}" Maximum="100" />
                        <TextBlock Text="{Binding FiveHourDetail}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="周额度" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WeeklyRemaining}" FontSize="40" FontWeight="Bold" />
                        <ProgressBar Value="{Binding WeeklyRemainingValue}" Maximum="100" />
                        <TextBlock Text="{Binding WeeklyDetail}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="Codex 路径" FontWeight="SemiBold" />
                <TextBox Text="{Binding CodexPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="CodexPath_LostFocus" PlaceholderText="首次刷新时自动定位；也可手动填写 codex.exe 路径" />
                <TextBlock Text="手动修改会保存，并在下一次刷新时优先使用。" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
